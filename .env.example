# Human Learning Platform — Server Environment Variables
# Copy this file to .env and insert your real Groq API key for live AI tutoring.
# DO NOT commit .env to version control.
# DO NOT prefix server secrets with VITE_ (Vite bundles VITE_ variables into public client code).

# Groq API Key from Groq Console (https://console.groq.com/keys)
GROQ_API_KEY=

# Optional model configuration (defaults to llama-3.3-70b-versatile)
# Supported production options: llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# Optional server port for standalone production server (defaults to 3000)
PORT=3000

# Optional proxy trust setting (set to true if behind a verified reverse proxy)
TRUST_PROXY=false
