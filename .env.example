# Human Learning Platform — Server Environment Variables
# Copy this file to .env and insert your real Gemini API key for live AI tutoring.
# DO NOT commit .env to version control.
# DO NOT prefix server secrets with VITE_ (Vite bundles VITE_ variables into public client code).

# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional model configuration (defaults to gemini-3.8-flash)
# Supported options: gemini-3.8-flash, gemini-2.5-flash
GEMINI_MODEL=gemini-3.8-flash

# Optional server port for standalone production server (defaults to 3000)
PORT=3000
